# ─────────────────────────────────────────────── СВЕТ, СТИЛЬ И КАЧЕСТВО ГРАФИКИ
## По умолчанию — чистый лёгкий полуреализм (PBR без селлшейдинга).
## Клавиша G позволяет переключить опциональный селлшейдинг для сравнения.
static var TOON_ENABLED := false

## Яркость лаборатории (клавиша B или Esc → Освещение):
##   0 — приглушённо (спокойнее, контрастнее)
##   1 — штатно (стерильная белая лаборатория в духе Mirror's Edge, без засвета)
##   2 — ярко (операционная белизна)
static var BRIGHTNESS := 1
const BRIGHTNESS_NAMES := ["приглушённо", "штатно", "ярко"]

## Пресет качества графики (клавиша F4 или Esc → Качество графики):
##   0 — низкое: 85% 3D-разрешения, без сглаживания/SSAO/отражений (макс. FPS, даже на iGPU)
##   1 — среднее (940MX): 1280x720, без AA, мягкие тени 1 каскад, статичные отражения зала
##   2 — высокое: 1280x720, 2x MSAA, мягкий SSAO в углах, тени и отражения зала
static var QUALITY := 1
const QUALITY_NAMES := ["низкое", "среднее (940MX)", "высокое"]

# ─────────────────────────────────────────────── ОКРУЖЕНИЕ
const ROOM_WIDTH := 18.0
const ROOM_DEPTH := 18.0
const ROOM_HEIGHT := 5.0


## Та же кривая пройденного пути, что при авторинге уворота.
static func dodge_progress(value: float) -> float:
	var u := clampf(value, 0, 1)
	return u * u * u * (10.0 - 15.0 * u + 6.0 * u * u)
