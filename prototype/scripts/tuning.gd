## Все настройки прототипа в одном файле.
##
## Меняйте числа здесь — они применятся при следующем запуске (F5).
## Это единственный файл, который нужно править для настройки ощущения.
extends RefCounted
class_name Tuning


# ─────────────────────────────────────────────── ДВИЖЕНИЕ
const WALK_SPEED := 3.4          ## м/с, обычная ходьба
const RUN_SPEED := 6.2           ## м/с, бег (на Shift)
const ACCELERATION := 16.0       ## как быстро набирается скорость
const DECELERATION := 20.0       ## как быстро гасится скорость
const TURN_SPEED := 14.0         ## скорость поворота тела к направлению движения
const GRAVITY := 24.0
const GRAVITY_FALL := 34.0       ## падение тяжелее подъёма — так прыжок «собраннее»
const JUMP_HEIGHT := 1.15        ## метры; скорость считается из высоты
const AIR_CONTROL := 0.55        ## доля управления в воздухе
const COYOTE_TIME := 0.10        ## прыжок возможен чуть позже схода с края
const STEP_UP := 0.35            ## высота ступеньки, которую персонаж переступает

# ─────────────────────────────────────────────── КАМЕРА
const MOUSE_SENSITIVITY := 0.0022
const CAMERA_PITCH_MIN := -60.0  ## градусы, вниз
const CAMERA_PITCH_MAX := 45.0   ## градусы, вверх
const CAMERA_DISTANCE := 3.6
const CAMERA_HEIGHT := 1.45
const CAMERA_FOLLOW_SPEED := 12.0

# ─────────────────────────────────────────────── УВОРОТ
const DODGE_SPEED := 8.5
const DODGE_DURATION := 0.42     ## полная длительность переката
const DODGE_IFRAMES_START := 0.04  ## с какого момента включается неуязвимость
const DODGE_IFRAMES_END := 0.30    ## до какого момента действует неуязвимость
const DODGE_STAMINA := 22.0

# ─────────────────────────────────────────────── АТАКА
const ATTACK_WINDUP := 0.18      ## замах: ещё нет урона
const ATTACK_ACTIVE := 0.12      ## активные кадры: урон наносится
const ATTACK_RECOVERY := 0.26    ## восстановление: уязвим, но можно отменить уворотом
const ATTACK_RANGE := 1.9
const ATTACK_ANGLE := 70.0       ## половина угла конуса попадания, градусы
const ATTACK_DAMAGE := 24.0
const ATTACK_STAMINA := 18.0
const ATTACK_CANCEL_WINDOW := 0.12  ## за сколько до конца можно отменить уворотом

# ─────────────────────────────────────────────── ВВОД
const INPUT_BUFFER := 0.16       ## сколько помнится нажатие, если действие ещё занято

# ─────────────────────────────────────────────── ЗДОРОВЬЕ И СТАМИНА
const MAX_HEALTH := 100.0
const MAX_STAMINA := 100.0
const STAMINA_REGEN := 28.0      ## в секунду
const STAMINA_REGEN_DELAY := 0.55 ## пауза после траты, прежде чем начать восстановление

# ─────────────────────────────────────────────── СПРАЙТ-ПРОВЕРКА (заглушка врага)
const DUMMY_HEALTH := 60.0
const DUMMY_KNOCKBACK := 0.35

# ─────────────────────────────────────────────── КЛОН-ПРОТИВНИК
const CLONE_HEALTH := 120.0
const CLONE_WALK := 2.6          ## м/с, спокойный шаг
const CLONE_RUN := 4.6           ## м/с, сближение
const CLONE_ACCEL := 12.0
const CLONE_KEEP_DISTANCE := 1.6 ## ближе не подходит, пока не бьёт
const CLONE_RANGE := 2.0         ## радиус удара
const CLONE_DAMAGE := 14.0
const CLONE_WINDUP := 0.34       ## замах заметно длиннее, чем у игрока
const CLONE_ACTIVE := 0.12
const CLONE_RECOVER := 0.45
const CLONE_COOLDOWN := 0.9      ## пауза между ударами

# ─────────────────────────────────────────────── СТИЛЬ РЕНДЕРА
## Селлшейдинг (toon) для персонажей.
## true  — «рисованный» вид: ступенчатое затенение, контровой контур.
## false — обычное освещение (похоже на PBR, но моделей это слабое место).
## Переключатель сделан специально: два стиля нужно сравнить на экране,
## а не выбирать вслепую.
## static — обязательно. Обычное `var` в GDScript принадлежит ЭКЗЕМПЛЯРУ
## скрипта, а обращение `T.TOON_ENABLED` (через сам скрипт, без экземпляра)
## к обычному полю не работает: «Cannot find member in base "Tuning"» —
## именно эту ошибку выдал Godot. static var принадлежит скрипту, поэтому
## читается и пишется как T.TOON_ENABLED из любого места.
static var TOON_ENABLED := true   ## переключается клавишей G в игре

## Яркость сцены. Отдельно от стиля — специально: «темновато» это про
## количество света, а не про селлшейдинг. Раньше я менял их вместе и
## исправлял одно, ломая другое.
##   0 — «сумрачно»: то, что было
##   1 — «средне»: по умолчанию, ощутимо светлее
##   2 — «ярко»: чистая белая лаборатория, почти стерильно
## Одежда: лабораторное платье, сгенерированное кодом (tools/garment).
## false — снять платье, не трогая файлы. Нужно, чтобы посмотреть анатомию,
## веса или сравнить «до/после».
static var DRESS_ENABLED := true

static var BRIGHTNESS := 1
const BRIGHTNESS_NAMES := ["сумрачно", "средне", "ярко"]

# ─────────────────────────────────────────────── ОКРУЖЕНИЕ
const ROOM_WIDTH := 18.0
const ROOM_DEPTH := 18.0
const ROOM_HEIGHT := 5.0
