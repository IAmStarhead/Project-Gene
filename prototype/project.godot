; Прототип Gen — тестовая комната и управление
; Godot 4.7.2, рендерер Compatibility (OpenGL 3.3) для GeForce 940MX
; Настройки ощущения — в scripts/tuning.gd

config_version=5

[application]

config/name="Gen Prototype"
config/description="Тестовая комната: движение, камера, уворот, удар, стамина."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/anisotropic_filtering_level=0
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.82, 0.86, 0.92, 1)

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=24.0

[input]

